# ---------------------------------------------------------
# 기본 실행
# ---------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
DATABASE_URL=sqlite:///./data/memory_recall.db
AUTO_CREATE_TABLES=true

# demo | header | supabase
AUTH_MODE=demo
DEMO_USER_ID=demo-user
# AUTH_MODE=header이면 모든 개인 API 요청에 X-User-Id 헤더가 필요합니다.
# AUTH_MODE=supabase이면 아래 JWT secret이 필요합니다.
SUPABASE_JWT_SECRET=

# ---------------------------------------------------------
# 저장소: local | supabase
# ---------------------------------------------------------
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/uploads
MAX_UPLOAD_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=memory-images

# Supabase Database를 사용할 때 대시보드의 Postgres/Pooler 접속 문자열을 사용하세요.
# 예: postgresql+psycopg://postgres.PROJECT:password@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
# DATABASE_URL=

# ---------------------------------------------------------
# AI: mock | auto | upstage
# mock: 외부 키 없이 전체 플로우 동작
# auto: 키가 있으면 Upstage, 실패하면 mock
# upstage: Upstage 실패를 그대로 오류로 반환
# ---------------------------------------------------------
AI_MODE=mock
AI_FALLBACK_TO_MOCK=true
UPSTAGE_API_KEY=
UPSTAGE_BASE_URL=https://api.upstage.ai/v1
UPSTAGE_SOLAR_MODEL=solar-pro3
UPSTAGE_DOCUMENT_PARSE_URL=https://api.upstage.ai/v1/document-digitization
UPSTAGE_DOCUMENT_PARSE_MODEL=document-parse
UPSTAGE_INFORMATION_EXTRACT_URL=https://api.upstage.ai/v1/information-extraction
UPSTAGE_INFORMATION_EXTRACT_MODEL=information-extract
# 텍스트만 있는 기억을 Information Extract에 전달할 때 사용할 한글 글꼴 경로.
# 비워두면 Linux/macOS/Windows의 대표 시스템 글꼴을 자동 탐색합니다.
UPSTAGE_TEXT_RENDER_FONT_PATH=
UPSTAGE_TIMEOUT_SECONDS=60

# 추억 카드 이미지 생성: mock(로컬), auto(Gemini 실패 시 mock), gemini(실제 호출만)
CARD_IMAGE_GENERATION_ENABLED=true
CARD_IMAGE_MODE=mock
GEMINI_API_KEY=
NANO_BANANA_MODEL=gemini-3.1-flash-image
NANO_BANANA_TIMEOUT_SECONDS=120

# ---------------------------------------------------------
# 회상 일정
# ---------------------------------------------------------
DEMO_MODE=true
DEMO_DAY_SECONDS=2
FIRST_RECALL_DAYS=7
SECOND_RECALL_DAYS=30
ALLOW_EARLY_RECALL=false

# ---------------------------------------------------------
# 동네 추억 카드
# ---------------------------------------------------------
TOWN_MIN_CONTRIBUTORS=3
ADMIN_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_TOKEN_SECRET=
ADMIN_TOKEN_HOURS=8
SHARE_PREVIEW_SECRET=replace-with-a-long-random-secret
PLACE_TAGS=["감천문화마을","개금","경성대·부경대","광안리","괴정","구포","금정산","기장","남천","남포동","다대포","대신","덕천","동래","만덕","망미","명륜","명지","문현","반송","반여","범일","부곡","부산대학교","부산역","사상","서면","센텀","송도","송정","수영","수정","신평","안락","엄궁","연산동","영도","온천천","용호동","일광","장림","재송","전포","정관","좌동","주례","토성","하단","해운대","화명"]

CORS_ORIGINS=["*"]
